+    // GsService2 expects Windows AuthKit/akd even when Windows Anisette
+    // reports its negotiated iTunes profile. This only changes the
+    // authentication endpoint's Client-Info header, not the ADI provisioning
+    // identity, other Anisette headers, or developer portal requests.
+    static func grandSlamClientInfo(_ negotiated: String) -> String {
+        guard negotiated.contains("<PC> <Windows;6.2(0,0);9200>"),
+              negotiated.contains("com.apple.iTunes/12.12.4.1") else {
+            return negotiated
+        }
+        return negotiated.replacingOccurrences(
+            of: "com.apple.iTunes/12.12.4.1",
+            with: "com.apple.akd/1.0"
+        )
+    }
